          "http": {
            "method": "GET",
            "url": "https://api.thunes.com/v2/money-transfer/reports/:id/files",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List report files"
        },
        {
          "info": {
            "name": "Get a report file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.thunes.com/v2/money-transfer/reports/:report_id/files/:id",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a report file"
        }
      ]
