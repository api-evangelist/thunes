              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Payer identifier."
              },
              {
                "name": "transaction_type",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get beneficiary credit-party information"
        },
        {
          "info": {
            "name": "Verify beneficiary account status",
